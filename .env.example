# Copy to .env and fill in what you need. Everything is optional —
# static analysis works with no keys at all.

# ── AI providers (any one is enough; several = automatic failover) ──
GROQ_API_KEY=            # free: https://console.groq.com/keys          (gsk_…)
GEMINI_API_KEY=          # free tier: https://aistudio.google.com/app/apikey (AIza…)
OPENAI_API_KEY=          # paid: https://platform.openai.com/api-keys  (sk-…)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini

# ── Local AI (Ollama) ──
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# DISABLE_OLLAMA=1       # skip the Ollama health check on cloud hosts

# ── Remote code-execution sandbox (runs languages not installed locally) ──
# PISTON_URL=https://your-piston-host/api/v2
# PISTON_KEY=
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_KEY=
# RUN_REMOTE_ONLY=1      # never execute user code on the app server itself

# ── GitHub (raises rate limit 60 → 5000 req/hr, enables private repos) ──
# GITHUB_TOKEN=

# ── Optional semantic RAG (heavy: downloads an embedding model) ──
# ENABLE_CHROMA=1

# ── Database (SQLite by default) ──
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Local development: point the frontend at your local backend ──
# API_URL=http://localhost:8000
