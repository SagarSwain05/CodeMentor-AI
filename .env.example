# Copy to .env and fill in what you need. Everything is optional —
# static analysis works with no keys at all.

# ── AI providers (any one is enough; several = automatic failover) ──
# Each variable accepts several comma-separated keys; rate-limited keys rotate.
GROQ_API_KEY=            # free: https://console.groq.com/keys          (gsk_…)
GEMINI_API_KEY=          # free tier: https://aistudio.google.com/app/apikey (AIza… or AQ.…)
OPENAI_API_KEY=          # paid: https://platform.openai.com/api-keys  (sk-…)
# Models are auto-discovered when a configured one is retired. Optional overrides:
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-4o-mini
# AI_REQUEST_DEADLINE=60  # hard per-request timeout (seconds)

# ── Local AI (Ollama) ──
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# DISABLE_OLLAMA=1       # skip the Ollama health check on cloud hosts

# ── Code execution ──
# Code runs in free, isolated sandboxes (Compiler Explorer, Wandbox, Paiza.IO, TIO)
# for ~40 languages out of the box — no keys needed.
RUN_REMOTE_ONLY=1        # production: never execute user code on the app server
# RUN_PREFER_LOCAL=1     # development: use local toolchains first (fast/offline)
# Optional self-hosted sandboxes, tried after the free ones:
# PISTON_URL=https://your-piston-host/api/v2
# PISTON_KEY=
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_KEY=

# ── GitHub (raises rate limit 60 → 5000 req/hr, enables private repos) ──
# GITHUB_TOKEN=

# ── Optional semantic RAG (heavy: downloads an embedding model) ──
# ENABLE_CHROMA=1

# ── Database (SQLite by default) ──
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Advanced ──
# API_URL=https://your-backend-host   # only to point the frontend at another backend
